OBS_API_KEY=your_secret_key_here

# ─── Whisper Configuration ────────────────────────────────────────────
# WHISPER_MODEL: tiny, base, small, medium, large-v3
#   tiny  → Fastest, least accurate
#   base  → Good speed/accuracy balance
#   small → High accuracy, slower
#   medium → Balanced performance
#   large-v3-turbo → Best speed/accuracy tradeoff (recommended)
#   large-v3 → Highest accuracy, slowest
WHISPER_MODEL=large-v3-turbo

# WHISPER_THREADS: CPU threads to use for inference
#   Recommended: number of physical cores (not hyperthreaded)
WHISPER_THREADS=6

# WHISPER_USE_GPU: Enable GPU context (true / false)
#   true  → Uses GPU backend (requires Vulkan or CUDA build, see below)
#   false → Uses CPU only
#
# GPU Installation guide:
#   Vulkan (AMD/any GPU): GGML_VULKAN=1 pip install git+https://github.com/absadiki/pywhispercpp
#   CUDA   (NVIDIA):      GGML_CUDA=1   pip install git+https://github.com/absadiki/pywhispercpp
#   CPU only:             pip install pywhispercpp
WHISPER_USE_GPU=true

# ─── AI Translator Configuration ─────────────────────────────────────
# TRANSLATOR_PROVIDER controls which translation backend is used.
#   none    → Disabled. Whisper handles translation natively (English only).
#   generic → Any OpenAI-compatible API (Ollama, vLLM, LM Studio, etc.)
#             Use this when hosting Gemma 4 or any open-source model locally.
TRANSLATOR_PROVIDER=none

# TRANSLATOR_BASE_URL: Base URL of your OpenAI-compatible API server.
#   Ollama default:    http://localhost:11434/v1
#   vLLM default:      http://localhost:8000/v1
#   LM Studio default: http://localhost:1234/v1
TRANSLATOR_BASE_URL=http://localhost:11434/v1

# TRANSLATOR_API_KEY: API key for the translation service.
#   For local servers (Ollama, vLLM), use any non-empty string (e.g. "ollama").
#   For hosted APIs (OpenAI, Groq, etc.), use your actual API key.
TRANSLATOR_API_KEY=ollama

# TRANSLATOR_MODEL: Model identifier as the server expects it.
#   Examples: gemma4, gemma2:27b, llama3.1:8b, gpt-4o-mini
TRANSLATOR_MODEL=gemma4

# TRANSLATOR_MAX_TOKENS: Maximum tokens the model can output per segment.
#   Keep this low (128-256) for low latency on short speech segments.
TRANSLATOR_MAX_TOKENS=256
